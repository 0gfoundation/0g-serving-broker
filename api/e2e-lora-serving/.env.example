# ============================================================
# E2E Real 0G Storage Test — Environment Configuration
# ============================================================
# Copy this file: cp .env.example .env
# Edit values, then load: set -a && source .env && set +a
# Run test: python3 e2e_real_0g_storage_test.py
# ============================================================

# ── Chain ──────────────────────────────────────────────────
# RPC endpoint and chain ID for the 0G network.
RPC_URL=https://evmrpc-testnet.0g.ai
CHAIN_ID=16602

# Provider wallet private key (hex, no 0x prefix).
# Must have gas balance on the target chain.
PROVIDER_PRIVATE_KEY=your_private_key_here

# FineTuningServing contract address.
FT_CONTRACT_ADDRESS=0x47AFe74CEa37Fd2b575a6768615A9e6A0149eA91

# Path to the FineTuningServing ABI JSON file.
# Extract from: api/libs/0g-serving-contract/deployments/zgTestnetV4/FineTuningServing_v1.1Impl.json
# using: jq '.abi' < FineTuningServing_v1.1Impl.json > ft-serving-abi.json
FT_ABI_PATH=/tmp/ft-serving-abi.json

# ── Remote CVM ────────────────────────────────────────────
# Phala CVM hash (the full 40-char hex ID).
CVM_HASH=your_cvm_hash_here

# Phala gateway domain (default: dstack-pha-in2.phala.network).
CVM_GATEWAY=dstack-pha-in2.phala.network

# Ports on the CVM (exposed via Phala HTTPS tunnels).
CVM_BROKER_PORT=3081
CVM_SLLM_PORT=8343
CVM_VLLM_PORT=8000

# Override the full broker URL if not using default Phala tunnel format.
# CVM_BROKER_URL=https://my-custom-broker:3081

# ── 0G Storage ────────────────────────────────────────────
# Path to the 0g-storage-client binary (built from latest main).
STORAGE_CLIENT_PATH=/path/to/0g-storage-client

# 0G Storage indexer URL. Testnet uses the turbo indexer.
STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai

# ── LoRA Adapter Source ───────────────────────────────────
# Provide ONE of these:
#   ADAPTER_TARBALL — path to .tar.gz containing adapter_config.json + adapter_model.safetensors
#   ADAPTER_DIR     — path to directory containing adapter_config.json + adapter_model.safetensors
ADAPTER_TARBALL=/tmp/real-e2e-test/real-adapter.tar.gz
# ADAPTER_DIR=/path/to/my-adapter

# ── Internal API Auth ──────────────────────────────────────
# Shared secret for authenticating internal API calls to the inference broker.
# Must match the inference broker's lora.internalApiSecret config value.
INTERNAL_API_SECRET=

# ── Test Parameters (optional) ────────────────────────────
# Override task ID (default: auto-generated e2e-<uuid>).
# TASK_ID=my-test-001

# Polling interval and timeout for waiting for vLLM deployment (seconds).
POLL_INTERVAL=5
POLL_TIMEOUT=300
